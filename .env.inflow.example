# Platform identity only. Nothing about Anthropic belongs in this file — the
# agent's credential comes from a settings profile or from the host's own
# `claude` login.
PLUGIN_ID=aa-bbb-ccc-dddd
INFRA_CRED=LS0tLS1CRUdJTiBOQVRTIFVTRVIgSldULS0t...
INFRA_URL=localhost:4222

# Optional, host-side policy:
# The default workspace root when a settings profile names none.
# CLAUDE_WORKSPACE_ROOT=/srv/claude-workspaces
# The claude executable, when it is not on PATH.
# CLAUDE_EXECUTABLE=/usr/local/bin/claude
# NATS request deadline for the plugin's own commands, in seconds (code default 60).
# REQ_TIMEOUT=60
